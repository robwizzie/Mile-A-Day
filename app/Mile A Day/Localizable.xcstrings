    "Calls out your pace and splits as you run, the halfway turnaround, and — when you're racing — every lead change." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sagt dir beim Laufen Tempo und Splits an, die Halbzeit und – bei einem Rennen – jeden Führungswechsel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Te dice tu ritmo y tus parciales mientras corres, cuándo llegas a la mitad y, si estás compitiendo, cada cambio de liderato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Annonce ton allure et tes splits pendant que tu cours, la mi-parcours et — en course — chaque changement de tête."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fala seu ritmo e parciais enquanto você corre, a metade do caminho e — quando está competindo — cada troca de liderança."
          }
        }
      }
    },
