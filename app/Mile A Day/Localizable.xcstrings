    },
    "You keep showing up — that's the whole game. If Mile A Day's helped you keep the streak alive, a quick rating helps other runners find us. 🙏" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sigues apareciendo, y de eso va todo. Si Mile A Day te ha ayudado a mantener viva tu racha, una valoración rápida ayuda a otros corredores a encontrarnos. 🙏"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Você continua aparecendo — é disso que se trata. Se o Mile A Day ajudou a manter sua sequência viva, uma avaliação rápida ajuda outros corredores a nos encontrar. 🙏"
          }
        }
      }
    },
    "You missed yesterday. Run %@ mi today to Double Down and save it." : {
