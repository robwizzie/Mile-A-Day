    "Which one?" : {
      "comment" : "A title for a sheet that lets the user choose which of a post's faces to include in a highlight.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Cuál?"
