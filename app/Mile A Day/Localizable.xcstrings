        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Caminhadas, corridas e fotos suas e dos seus amigos aparecem aqui. Adicione amigos e comece a se mexer!"
          }
        }
      }
    },
    "Want a richer voice? Settings → Accessibility → Spoken Content → Voices has free downloads, and the coach picks one up on its own. It works fine without." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Quieres una voz más natural? En Ajustes → Accesibilidad → Contenido leído → Voces hay descargas gratuitas, y el entrenador la usará solo. Funciona bien sin ella."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quer uma voz mais natural? Em Ajustes → Acessibilidade → Conteúdo Falado → Vozes há downloads gratuitos, e o treinador escolhe uma sozinho. Funciona bem sem."
          }
        }
      }
    },
