    "When your account is private, only your username and profile picture are visible to other users. All other information is hidden." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cuando tu cuenta es privada, los demás solo ven tu nombre de usuario y tu foto de perfil. El resto de la información queda oculta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
