        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Routen, die währenddessen aufgezeichnet werden, werden nie hochgeladen und können nie gezeigt werden, auch nicht nach dem Ausschalten. Routenkarten teilen (oben) blendet Karten nur in der Anzeige aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las rutas grabadas mientras está activado nunca se suben ni se pueden mostrar, aunque lo desactives. Compartir mapas de ruta (arriba) solo oculta los mapas a la vista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les parcours enregistrés pendant que c'est activé ne sont jamais envoyés et ne pourront jamais être montrés, même après désactivation. Partager les cartes de parcours (ci-dessus) masque seulement l'affichage des cartes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As rotas gravadas com isso ativado nunca são enviadas e nunca poderão ser mostradas, mesmo depois de desativar. Compartilhar mapas de rota (acima) só oculta os mapas na exibição."
          }
        }
      }
    },
