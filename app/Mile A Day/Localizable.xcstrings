    "Close friends can get notifications others don't. They're never told.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enge Freunde können Mitteilungen bekommen, die andere nicht bekommen. Sie erfahren es nie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los amigos cercanos pueden recibir avisos que otros no. Nunca se les dice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les amis proches peuvent recevoir des notifications que les autres n'ont pas. Ils ne le savent jamais."
          }
        },
        "pt-BR": {
