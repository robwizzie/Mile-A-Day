    "This will discard the stuck workout and clear all workout state. Use this if the workout is frozen or won't end properly." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das verwirft das hängende Workout und löscht alle Workout-Daten. Nutze das, wenn das Workout eingefroren ist oder nicht richtig endet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
